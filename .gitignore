*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Local databases ----
*.db
*.db-journal
*.sqlite
*.sqlite3

# ---- Node / Vite (frontend) ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
