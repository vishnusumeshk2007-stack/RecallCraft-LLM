# Base path the frontend calls for API requests. Keep it relative so the Vite
# dev server proxies it to the FastAPI backend (see vite.config.js).
# In production (Vercel) set the absolute backend URL instead, e.g.
#   VITE_API_BASE=https://recallcraft.onrender.com/api
VITE_API_BASE=/api

# Absolute URL of the FastAPI backend. Used as a fallback when VITE_API_BASE is
# empty; a bare origin gets `/api` appended automatically.
# The dev server proxies /api -> http://127.0.0.1:8001 by default.
VITE_API_URL=http://localhost:8001
