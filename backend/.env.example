# ============================================================
# RecallCraft backend configuration
# Copy to `.env` and fill in the key for your chosen provider.
# ============================================================

# ---------- LLM ----------
# One of: groq | openai | gemini | openrouter | stub
# `stub` runs a fully deterministic offline generator (no API key needed).
LLM_PROVIDER=groq
# Leave blank to use the provider default model (see llm/client.py)
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
REQUEST_TIMEOUT=120

# Groq model id. Groq retires ids regularly — a stale one returns
# HTTP 404 `model_not_found`. Check the ids your key can actually use with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-20b

# ---------- Provider API keys ----------
# Only the one matching LLM_PROVIDER is required.
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPEN_ROUTER_API_KEY=

# ---------- Embeddings ----------
# One of: local | openai | sentence-transformers
# `local` is a zero-dependency deterministic hashing embedder (default).
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# ---------- Generation / pipeline tuning ----------
DEDUPE_THRESHOLD=0.92
MAX_CHUNK_CHARS=1200
CHUNK_OVERLAP_SENTENCES=1
CARDS_PER_CHUNK=3
# Max upload size in bytes (default 15 MB)
MAX_UPLOAD_BYTES=15728640

# ---------- OCR fallback (scanned PDFs) ----------
# A PDF with fewer than OCR_MIN_CHARS of selectable text is re-read with
# pdf2image + pytesseract. Requires the Poppler and Tesseract binaries.
OCR_ENABLED=true
OCR_MIN_CHARS=50
OCR_LANGUAGE=eng
OCR_DPI=200

# ---------- Database ----------
# SQLite by default; swap for Postgres, e.g.
# postgresql+psycopg://user:pass@localhost:5432/recallcraft
DATABASE_URL=sqlite:///./recallcraft.db

# ---------- CORS ----------
# Left open (`allow_origins=["*"]`) so the Vercel deployment, preview URLs and
# custom domains can all reach the API. See app/main.py.
